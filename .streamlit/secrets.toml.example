# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# `.streamlit/secrets.toml` is gitignored and must never be committed.
# These values can also be supplied as environment variables of the same name.

GEMINI_API_KEY = "your-gemini-api-key-here"
DESK_PASSCODE = "choose-a-desk-passcode"

# Demo mode (optional, defaults to false). When true, the verification form also
# accepts @gmail.com addresses so the flow can be demonstrated without a real UTD
# account. Leave false (or unset) for the live app, which requires a UTD email.
DEMO_MODE = false
